      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const rule = $('When fetching a dataset row').first().json.rule_text;\n  const actual = item.json.output;\n  const body = {\n    model: 'gpt-4o-mini',\n    temperature: 0,\n    messages: [\n      {\n        role: 'system',\n        content: 'You are a strict grader. Reply with only a JSON object: { \"score\": <0 to 1>, \"reason\": \"<one sentence>\" }. No other text.'\n      },\n      {\n        role: 'user',\n        content: `Rule: ${rule}\\nActual output: ${actual}`\n      }\n    ]\n  };\n  \n  return { json: { requestBody: JSON.stringify(body) } };\n});\n"
      },
