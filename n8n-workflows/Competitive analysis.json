        "httpHeaderAuth": {
          "id": "D1mmHKZDMu4gMr70",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  try {\n    const raw = item.json.choices?.[0]?.message?.content;\n    \n    if (!raw) {\n      return { json: { error: \"No content found in input data\" } };\n    }\n    \n    const cleanRaw = raw.replace(/^```json\\s*/i, \"\").replace(/```\\s*$/, \"\").trim();\n    const parsed = JSON.parse(cleanRaw);\n    \n    return { \n      json: { \n        score: parsed.score ?? null, \n        reason: parsed.reason ?? \"No reason provided\" \n      } \n    };\n  } catch (error) {\n    return { \n      json: { \n        error: \"Failed to parse JSON\", \n        details: error.message, \n        raw_content: item.json.choices?.[0]?.message?.content \n      } \n    };\n  }\n});\n"
      },
