    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n    const steps = item.json.intermediateSteps || [];\n    const actualTools = steps.map(s => s.action?.tool).filter(Boolean);\n\n    const expectedRaw = ($('When fetching a dataset row').first()?.json.expected_tools || '').trim().toLowerCase();\n    const expectedTools = (expectedRaw === '' || expectedRaw === 'none')\n      ? []\n      : expectedRaw.split(',').map(t => t.trim()).filter(Boolean);\n\n    const actualSet = new Set(actualTools.map(t => t.toLowerCase()));\n    const expectedSet = new Set(expectedTools);\n\n    const setsMatch = actualSet.size === expectedSet.size &&\n      [...expectedSet].every(t => actualSet.has(t));\n\n    return {\n      json: {\n        ...item.json,\n        actual_tools: actualTools.join(', ') || 'none',\n        correct_routing: setsMatch ? 1 : 0\n      }\n    };\n});\n"
      },
